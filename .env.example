# Resend (https://resend.com/api-keys). Needs send + contacts + broadcasts access.
RESEND_API_KEY=re_xxx
# Segment that holds confirmed subscribers (Resend → Audience → Segments).
RESEND_SEGMENT_ID=
# Signs double opt-in links. Generate with: openssl rand -base64 48
SUBSCRIBE_SECRET=
# Where `pnpm send <slug> --test` delivers. Defaults to site.newsletter.replyTo.
NEWSLETTER_TEST_TO=
# Any random 32-char hex string. Generate with: openssl rand -hex 16
INDEXNOW_KEY=
# Optional: webhook forwarding of inbound mail (site.config.ts → inbound.forwarding = true).
# Signing secret from `resend webhooks create`, and the address to forward to.
# Leave empty if you use Resend Inboxes only, or don't receive mail.
RESEND_WEBHOOK_SECRET=
INBOX_FORWARD_TO=
